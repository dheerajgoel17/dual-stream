{
  "manifest_version": 3,
  "name": "Multi Streams",
  "version": "2.0.0",
  "description": "Watch up to 9 streams or pages at once — sports channels and web pages side by side.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Multi Streams",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "tabCapture",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "pip-current": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Picture-in-Picture the current tab's video"
    },
    "open-split": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open the Multi Streams grid"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/embed.js",
        "shared/stream-detect.js",
        "shared/zlive.js",
        "shared/ondemand.js",
        "shared/aggregators.js",
        "shared/streaming.js",
        "content/content.js"
      ],
      "css": ["content/overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.ninguno.cc/*",
        "*://*.vipbox.fm/*",
        "*://*.vipbox.lc/*",
        "*://*.embedsports.top/*"
      ],
      "js": ["shared/stream-detect.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
